{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notia",
  "version": "1.0.10-ALPHA",
  "identifier": "com.gabriel.notia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://192.168.1.41:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notia",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
