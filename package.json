{
  "name": "notia",
  "private": true,
  "version": "1.0.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:tauri:windows": ".\\scripts\\tauri-dev-windows.cmd",
    "build:tauri:windows": ".\\scripts\\tauri-build-windows.cmd",
    "dev:tauri": "./scripts/tauri-dev-linux.sh",
    "dev:tauri:linux": "./scripts/tauri-dev-linux.sh",
    "dev:tauri:auto": "./scripts/tauri-dev-linux.sh",
    "dev:tauri:wayland": "NOTIA_TAURI_BACKEND=wayland NOTIA_TAURI_FALLBACK_X11=0 ./scripts/tauri-dev-linux.sh",
    "dev:tauri:wayland:fallback": "NOTIA_TAURI_BACKEND=wayland NOTIA_TAURI_FALLBACK_X11=1 ./scripts/tauri-dev-linux.sh",
    "dev:android": "node ./scripts/android-dev.mjs",
    "build:android:debug": "node ./scripts/tauri-cli.mjs android build --apk --debug --target aarch64",
    "build:android:release": "node ./scripts/android-build-release.mjs",
    "build:android:aab": "node ./scripts/android-build-release.mjs --aab",
    "install:android:release": "node ./scripts/android-install-release.mjs",
    "dev:tauri:x11": "NOTIA_TAURI_BACKEND=x11 ./scripts/tauri-dev-linux.sh",
    "build:tauri": "./scripts/tauri-build-release.sh"
  },
  "dependencies": {
