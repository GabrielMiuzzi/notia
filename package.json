    "@iconify/react": "^6.0.2",
    "@milkdown/crepe": "^7.19.0",
    "@milkdown/plugin-block": "^7.19.0",
    "@milkdown/plugin-clipboard": "^7.19.0",
    "@milkdown/plugin-cursor": "^7.19.0",
    "@milkdown/plugin-emoji": "^7.19.0",
    "@milkdown/plugin-history": "^7.19.0",
    "@milkdown/plugin-indent": "^7.19.0",
